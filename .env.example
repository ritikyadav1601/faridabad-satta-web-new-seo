# Separate MongoDB source for the 12 promoted Top Games on the homepage.
# The collection should contain one document per game/date, e.g.
# { game: "DESHAWER", resultDate: "2026-07-15", result: "73" }
TOP_GAMES_MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/top-games?retryWrites=true&w=majority
TOP_GAMES_MONGODB_DB=top-games
TOP_GAMES_MONGODB_COLLECTION=dailynumbers

# MongoDB source for the scraped_cache and custom_games collections.
EXTRA_GAMES_MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/extra-games?retryWrites=true&w=majority
EXTRA_GAMES_MONGO_DB=extra-games
EXTRA_GAMES_MONGO_COLLECTION=games
EXTRA_GAMES_RESULTS_COLLECTION=gameresults
EXTRA_GAMES_CACHE_COLLECTION=scraped_cache
EXTRA_GAMES_CUSTOM_COLLECTION=custom_games
